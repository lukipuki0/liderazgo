# Datos sensibles de la encuesta
# El repositorio es público: las respuestas originales tienen nombre, apellido y
# correo de cada persona, así que nunca se suben. Solo se publican resultados
# agregados (analisis/resultados.json y los gráficos).
*(Respuestas)*
*.xlsx
*.xls
*.ods
*.csv
*.tsv

# Credenciales y variables de entorno
.env
.env.*
*credentials*.json

# Archivos temporales de Office y del sistema
~$*
.~lock.*#
Thumbs.db
desktop.ini
.DS_Store

# Archivos auxiliares de LaTeX (compilación desde la raíz)
/*.aux
/*.bbl
/*.bcf
/*.blg
/*.fdb_latexmk
/*.fls
/*.log
/*.out
/*.run.xml
/*.toc
/*.lof
/*.lot
/*.synctex.gz
/*.xmpi
/main.pdf
